{
  "name": "velaterm",
  "private": true,
  "version": "0.1.101",
  "description": "VelaTerm — a terminal multiplexer GUI that manages terminals and AI agent sessions in one project/group/session tree",
  "author": "VLINX Software",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "node scripts/run-sh.cjs dev-desktop.sh",
    "dev:desktop": "node scripts/run-sh.cjs dev-desktop.sh",
    "dev:electron": "node scripts/run-sh.cjs dev-electron.sh",
    "dev:web": "node scripts/run-sh.cjs dev-serve.sh web",
    "dev:mobile": "node scripts/run-sh.cjs dev-serve.sh mobile",
    "dev:server": "node scripts/run-sh.cjs dev-server.sh",
    "dev:ls": "node ./scripts/dev-instances.cjs ls",
    "dev:stop": "node ./scripts/dev-instances.cjs stop",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "vitest run",
    "electron": "electron electron/main.cjs",
    "electron:dev": "vite build && cargo build --manifest-path src-tauri/Cargo.toml && electron electron/main.cjs",
    "electron:dist": "tsc && vite build && cargo build --release --manifest-path src-tauri/Cargo.toml && electron-builder"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "7.21.2",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.23.0",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
